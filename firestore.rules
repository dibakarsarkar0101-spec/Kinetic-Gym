rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Members collection: Public enrollment for gym members
    match /members/{memberId} {
      allow read: if true;
      allow create: if isValidId(memberId)
                    && incoming().name is string
                    && incoming().name.size() > 0
                    && incoming().name.size() <= 100
                    && incoming().phone is string
                    && incoming().phone.size() > 0
                    && incoming().phone.size() <= 30
                    && incoming().membershipPlan is string
                    && incoming().activeStatus in ['ACTIVE', 'PENDING', 'EXPIRED'];
      allow update, delete: if true;
    }

    // Trainers collection: Public directory
    match /trainers/{trainerId} {
      allow read: if true;
      allow write: if true;
    }

    // Membership Plans collection: Public pricing
    match /plans/{planId} {
      allow read: if true;
      allow write: if true;
    }

    // Announcements collection: Public gym notices
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    // Test connection endpoint
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
